# GA4 Web data stream Measurement ID. Leave empty to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Paddle.js client-side token. Use a sandbox token with sandbox and a live token with production.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your-paddle-client-side-token
# sandbox | production
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
NEXT_PUBLIC_BUSINESS_REPRESENTATIVE=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
